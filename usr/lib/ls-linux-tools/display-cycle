#!/bin/sh
set -eu
command -v xrandr >/dev/null 2>&1 || exit 0
state="${XDG_CACHE_HOME:-$HOME/.cache}/ls-linux-tools-display-state"
mkdir -p "$(dirname "$state")"
n=$(cat "$state" 2>/dev/null || echo 0)
n=$(((n + 1) % 4))
printf '%s\n' "$n" > "$state"
case "$n" in 0) rot=normal;; 1) rot=left;; 2) rot=inverted;; 3) rot=right;; esac
out=$(xrandr --query | awk '/ connected/ {print $1; exit}')
[ -n "$out" ] && xrandr --output "$out" --rotate "$rot"
